  },
  "mac": {
    "target": "dmg",
    "category": "public.app-category.utilities"
  },
  "win": {
    "target": "nsis"
  },
  "publish": {
    "provider": "github",
    "owner": "nexusmote",
    "repo": "nexusmote"
  }
