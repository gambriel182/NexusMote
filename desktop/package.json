{
  "name": "nexusmote-desktop",
  "version": "0.1.0",
  "description": "NexusMote desktop — turn your phone into a wireless touchpad for Linux",
  "main": "src/main.js",
  "author": "NexusMote",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "tsc",
    "pack": "electron-builder --linux AppImage",
